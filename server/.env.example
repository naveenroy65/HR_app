# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/hr_management_system

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Email Configuration (SMTP)
# For development, you can use services like Ethereal (https://ethereal.email)
# For production, use services like SendGrid, AWS SES, or your company SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-email@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM=noreply@weintegrity.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Security Configuration
ACCOUNT_LOCK_DURATION=30
MAX_LOGIN_ATTEMPTS=5
PASSWORD_RESET_EXPIRE=3600000
