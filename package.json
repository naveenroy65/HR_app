{
  "name": "complete-hr-management-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n client,server -c auto \"vite\" \"npm:dev:server\"",
    "server:dev": "cd server && npm run dev",
    "dev:fullstack": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "postinstall": "npm --prefix server install"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
